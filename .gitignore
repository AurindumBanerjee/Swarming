# Logs
*.log
*.out

# Images
*.png
*.jpg
*.jpeg

# Results / outputs
outputs/
results/
*.npy
*.npz

# Python
__pycache__/
*.pyc

# Scratch / experiments
ScratchBench*/

# MinTime/: legacy result folders stay ignored (files already tracked remain tracked).
# MinTime/Runs/ is the tracked home of every ScratchBench run: code, manifests, READMEs, INDEX.md and new_run.py are
# tracked; bulky output/ and logs/ are not.
MinTime/*
!MinTime/Runs/
MinTime/Runs/*/output/
MinTime/Runs/*/logs/
MinTime/Runs/GO_RUN3
# Per-run summaries and plots are tracked (including PNG/PDF); raw output/ and logs/ are not.
!MinTime/Runs/*/plots/
!MinTime/Runs/*/plots/**
!MinTime/Runs/*/analysis/**/*.png

# Large dataset binaries (178-209 MB each, over GitHub's 100 MB limit) are not tracked; they live on the server (see Dataset/README.md).
Dataset/*.mat
Dataset/*/*.mat

# ---- runs/ (see README.md and reference/README.md): code copies, manifests, READMEs, summaries and plots are tracked;
# raw output and logs are not. *.png / *.log above would hide tracked figures and samples, so they are re-included.
runs/*/*/output/
runs/*/*/logs/
runs/_ops/*.log
runs/_ops/*.out
runs/_ops/GO_RUN3
!runs/**/plots/**
!runs/**/analysis/**/*.png
!reference/output_style/**
